# Browser-safe Supabase project settings. Copy this file to .env.local.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional override. Development defaults to ws://127.0.0.1:9001/ws.
VITE_SERVER_URL=ws://127.0.0.1:9001/ws

# Never place a Supabase secret key or service_role key in a VITE_* variable.
