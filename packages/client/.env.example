# Browser-safe Supabase project settings. Copy this file to .env.local.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional override for a separate game server. Leave unset to use same-origin
# /ws (proxied to the local server by Vite during development).
# VITE_SERVER_URL=wss://game.example.com/ws

# Never place a Supabase secret key or service_role key in a VITE_* variable.
