{
  "name": "@labyrinth/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:full-assets": "tsc && vite build --mode full-assets",
    "sync:character-atlas": "python scripts/build-character-atlas.py",
    "sync:runtime-assets": "node scripts/sync-runtime-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@labyrinth/shared": "*",
    "@supabase/supabase-js": "^2.90.1",
    "fflate": "^0.8.3",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
