{
  "name": "@labyrinth/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:runtime-assets && npm run verify:runtime-atlas && tsc && vite build",
    "build:full-assets": "npm run verify:runtime-assets && npm run verify:runtime-atlas && tsc && vite build --mode full-assets",
    "sync:character-atlas": "python scripts/build-character-atlas.py",
    "sync:runtime-assets": "node scripts/sync-runtime-assets.mjs && npm run sync:runtime-atlas",
    "sync:runtime-atlas": "python scripts/build-runtime-atlas.py",
    "verify:runtime-assets": "node scripts/verify-runtime-assets.mjs",
    "verify:runtime-atlas": "python scripts/build-runtime-atlas.py --check",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@labyrinth/shared": "*",
    "@supabase/supabase-js": "^2.90.1",
    "@vercel/analytics": "^2.0.1",
    "fflate": "^0.8.3",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
