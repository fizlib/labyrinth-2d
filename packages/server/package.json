{
  "name": "@labyrinth/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @labyrinth/shared",
    "dev": "tsx watch --env-file-if-exists=../client/.env.local --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../client/.env.local --env-file-if-exists=.env.local dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --workspace @labyrinth/shared && npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@labyrinth/shared": "*",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.60.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  }
}
