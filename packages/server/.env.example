# Server-side Supabase settings used to verify players and persist match results.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# A legacy browser-safe anon key can be used as SUPABASE_ANON_KEY instead.
# A legacy service_role key can be used as SUPABASE_SERVICE_ROLE_KEY instead.
# Never expose either server secret in a VITE_* variable or browser bundle.
