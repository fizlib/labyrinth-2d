# Server-side Supabase settings used to verify players and persist match results.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional comma-separated browser origins for staging or custom frontends.
# The canonical https://falsearrow.com and https://www.falsearrow.com origins
# are allowed automatically.
# ADMIN_ALLOWED_ORIGINS=https://staging.example.com,http://localhost:5173

# A legacy browser-safe anon key can be used as SUPABASE_ANON_KEY instead.
# A legacy service_role key can be used as SUPABASE_SERVICE_ROLE_KEY instead.
# Never expose either server secret in a VITE_* variable or browser bundle.
